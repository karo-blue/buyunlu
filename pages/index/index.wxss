.nameselect-title { display: block; margin-top: 10rpx; color: #14213d; font-size: 38rpx; font-weight: 750; line-height: 1.3; }
.nameselect-sub { display: block; margin-top: 14rpx; color: #66758f; font-size: 24rpx; line-height: 1.65; white-space: pre-wrap; }

.nameselect-surname-row {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  margin-top: 26rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #d9e4f5;
