.nameselect-ph { color: #aeb6c6; }
.nameselect-error { display: block; margin: 12rpx 4rpx 0; color: #d95b67; font-size: 23rpx; line-height: 1.4; }

.nameselect-confirm {
  display: flex;
  align-items: center;
