.dialog-card-danger .dialog-title { color: #7d111c; }
.dialog-card-danger .dialog-content { color: #4c2830; }
.dialog-card-danger .dialog-footer { border-color: #f0c7ca; }
.dialog-card-danger .dialog-button.primary { color: #b42331; }
.dialog-card-danger .dialog-button.secondary { color: #8b5b62; border-color: #f0c7ca; }
.dialog-card-warning .dialog-kicker { color: #a6530b; }
.dialog-card-warning .dialog-title { color: #743304; }
.dialog-card-warning .dialog-content { color: #51331d; }
.dialog-card-warning .dialog-footer { border-color: #edcfaa; }
.dialog-card-warning .dialog-button.primary { color: #9b4707; }
.dialog-card-warning .dialog-button.secondary { color: #76573b; border-color: #edcfaa; }
.dialog-kicker { padding: 34rpx 36rpx 8rpx; color: #5c84c8; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.dialog-title { display: block; padding: 0 36rpx 18rpx; color: #14213d; font-size: 36rpx; line-height: 1.35; font-weight: 700; }
.dialog-content-scroll { display: block; flex: 0 1 auto; min-height: 0; max-height: 56vh; }
.dialog-body { width: 100%; box-sizing: border-box; }
.dialog-content { display: block; padding: 0 36rpx 30rpx; color: #66758f; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-word; }

/* 人生排行榜 / 老虎榜：结构化榜面行。自己那栏用主题色加粗，与别人区分。 */
.board-rows { display: block; padding: 0 36rpx 30rpx; }
.board-text { display: block; color: #66758f; font-size: 28rpx; line-height: 1.9; }
.board-section { display: block; margin-top: 18rpx; color: #8a94a8; font-size: 24rpx; letter-spacing: 2rpx; }
.board-entry { display: block; padding: 6rpx 0; }
.board-entry-main { display: flex; align-items: baseline; }
.board-medal { flex: 0 0 44rpx; width: 44rpx; margin-right: 8rpx; font-size: 26rpx; line-height: 1.2; }
.board-rank { flex: 0 0 auto; min-width: 84rpx; color: #66758f; font-size: 28rpx; }
.board-name { color: #3d465a; font-size: 28rpx; font-weight: 600; }
.board-name-player { color: #3978e6; }
.board-honor { flex: 0 0 auto; margin-left: 10rpx; padding: 0 12rpx; border-radius: 999rpx; background: rgba(242,174,85,.16); color: #9c6a1c; font-size: 20rpx; font-weight: 650; line-height: 1.7; white-space: nowrap; }
.board-position { margin-left: 16rpx; color: #9aa3b5; font-size: 24rpx; flex: 1 1 auto; }
.board-sub { display: block; margin: 4rpx 0 0 92rpx; color: #9aa3b5; font-size: 24rpx; }
.board-sub-player { color: #3978e6; }
.board-gap { display: flex; align-items: center; margin: 14rpx 0; }
.board-gap-line { flex: 1 1 auto; height: 1rpx; background: #dde3ec; }
.board-gap-text { flex: 0 0 auto; margin: 0 16rpx; color: #9aa3b5; font-size: 22rpx; }
.board-note { display: block; margin-top: 18rpx; padding-top: 12rpx; border-top: 1rpx solid #dde3ec; color: #a8b0c0; font-size: 22rpx; line-height: 1.6; }
.dialog-amount-wrap { display: flex; align-items: center; gap: 14rpx; margin: 0 36rpx 30rpx; padding: 0 20rpx; height: 88rpx; box-sizing: border-box; border: 1rpx solid #d9e4f5; border-radius: 20rpx; background: rgba(255,255,255,.78); }
.dialog-amount-label { flex-shrink: 0; color: #42577d; font-size: 25rpx; font-weight: 650; }
.dialog-amount-input { flex: 1; min-width: 0; color: #18284d; font-size: 28rpx; text-align: right; }
.dialog-amount-placeholder { color: #a3adbf; }
.dialog-amount-unit { flex-shrink: 0; color: #78859d; font-size: 24rpx; }
.dialog-options { width: 100%; box-sizing: border-box; padding: 0 20rpx 20rpx; }
.dialog-option { display: flex !important; align-items: center; justify-content: flex-start; width: 100% !important; min-width: 0 !important; height: auto !important; min-height: 84rpx !important; margin: 14rpx 0 !important; padding: 20rpx 22rpx !important; box-sizing: border-box; border: 1rpx solid #d9e4f5; border-radius: 20rpx !important; background: rgba(255,255,255,.76); color: #243b66; font-size: 27rpx; line-height: 1.35; letter-spacing: 0; text-align: left; white-space: normal; overflow: visible; word-break: break-word; }
.dialog-option-label { display: block; flex: 1; min-width: 0; overflow: visible; white-space: normal; text-overflow: clip; word-break: break-word; line-height: 1.45; text-align: left; }
.dialog-option::after, .dialog-button::after, .dialog-cancel::after { border: 0; }
.dialog-option:active { background: #e7f0ff; transform: scale(.985); }
.dialog-footer { display: flex; flex: 0 0 auto; border-top: 1rpx solid #e3eaf4; }
.dialog-button { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; height: 100rpx; margin: 0; padding: 0; box-sizing: border-box; border-radius: 0; background: transparent; font-size: 30rpx; font-weight: 700; line-height: 1; white-space: nowrap; }
.dialog-button.primary { color: #3978e6; }
.dialog-button.secondary { color: #77849a; border-right: 1rpx solid #e3eaf4; }
.dialog-share-button { gap: 12rpx; }
.dialog-share-button[disabled] { color: #a3afc4; opacity: .68; }
.share-icon {
  position: relative;
  display: inline-block;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  color: currentColor;
}
/* 微信里最常见的转发图标：一根水平箭杆指向右侧，箭头是右向的折角。
   旧版是斜向的"外链箭头"（↗），玩家容易误以为是跳转外部，换成转发语义更直白。 */
.share-icon::before {
  position: absolute;
  left: 3rpx;
  top: 14rpx;
  width: 20rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
  content: "";
}
.share-icon::after {
  position: absolute;
  right: 3rpx;
  top: 9rpx;
  width: 13rpx;
  height: 13rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}
.dialog-cancel { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: calc(100% - 56rpx); height: 88rpx; min-height: 88rpx; margin: 0 28rpx 24rpx; padding: 0; box-sizing: border-box; border-radius: 18rpx; background: #e8f0fc; color: #5d79a6; font-size: 28rpx; font-weight: 600; line-height: 1; white-space: nowrap; }

/* 突发事件弹窗：在季度结算之后弹出，必须当场表态，因此层级高于普通弹窗 */
.burst-mask {
  position: fixed;
  inset: 0;
  z-index: 127;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(18, 31, 56, .5);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
}

.burst-mask-open { display: flex; }

.burst-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  max-height: 84vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: 34rpx 0 28rpx;
  border: 1rpx solid rgba(255, 255, 255, .85);
  border-radius: 38rpx;
  background: linear-gradient(150deg, rgba(255, 255, 255, .99), rgba(255, 247, 238, .97));
  box-shadow: 0 28rpx 76rpx rgba(31, 61, 107, .3), inset 0 1rpx rgba(255, 255, 255, .9);
  animation: rise-in .34s ease both;
}

.burst-head { display: flex; align-items: center; justify-content: space-between; padding: 0 36rpx; }
.burst-tag { color: #b4763a; font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; }
.burst-flag { padding: 4rpx 16rpx; border-radius: 999rpx; background: rgba(180, 118, 58, .12); color: #b4763a; font-size: 21rpx; font-weight: 650; letter-spacing: 1rpx; }
/* 组织谈话是终局，配色要和普通突发区分开 */
.burst-flag-trial { background: rgba(195, 74, 69, .14); color: #b33f3a; }
.burst-flag-review { background: rgba(180, 118, 58, .16); color: #a2662f; }
.burst-title { display: block; padding: 12rpx 36rpx 0; color: #14213d; font-size: 36rpx; line-height: 1.34; font-weight: 720; }
.burst-scroll { display: block; flex: 0 1 auto; min-height: 0; max-height: 58vh; width: 100%; box-sizing: border-box; }
.burst-scene { display: block; padding: 20rpx 36rpx 0; color: #5d6a83; font-size: 27rpx; line-height: 1.72; white-space: pre-wrap; word-break: break-word; }
.burst-options { padding: 26rpx 24rpx 8rpx; }
.burst-option { display: flex !important; align-items: center; justify-content: flex-start; width: 100% !important; min-width: 0 !important; height: auto !important; min-height: 88rpx !important; margin: 0 0 16rpx !important; padding: 22rpx 24rpx !important; box-sizing: border-box; border: 1rpx solid #ecdcc9; border-radius: 20rpx !important; background: rgba(255, 255, 255, .86); color: #26364f; font-size: 27rpx; line-height: 1.35; letter-spacing: 0; text-align: left; white-space: normal; overflow: visible; word-break: break-word; }
.burst-option-label { display: block; flex: 1; min-width: 0; overflow: visible; white-space: normal; text-overflow: clip; word-break: break-word; line-height: 1.5; text-align: left; }
.burst-option::after { border: 0; }
.burst-option-pressed,
.burst-option:active { background: #fdf1e3; transform: scale(.985); }
.burst-tip { display: block; flex: 0 0 auto; padding: 12rpx 36rpx 0; color: #8d97ab; font-size: 22rpx; line-height: 1.5; }

.enter-one,
.enter-two,
.enter-three,
.enter-four,
.enter-five {
  animation: rise-in .42s ease both;
}

.enter-two { animation-delay: .04s; }
.enter-three { animation-delay: .08s; }
.enter-four { animation-delay: .12s; }
.enter-five { animation-delay: .16s; }

@keyframes rise-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .enter-one,
  .enter-two,
  .enter-three,
  .enter-four,
  .enter-five { animation: none; }
  .primary-button,
  .top-nav-item { transition: none; }
}

.nameselect-mask {
