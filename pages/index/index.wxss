.nameselect-picker { flex: 1; min-width: 0; }
.nameselect-picker-value { display: flex; align-items: center; justify-content: space-between; min-height: 84rpx; color: #1c2850; font-size: 28rpx; font-weight: 650; }
.nameselect-picker-arrow { color: #5c84c8; font-size: 23rpx; font-weight: 500; }

.nameselect-choice-head { display: flex; align-items: center; justify-content: space-between; min-height: 68rpx; margin-top: 22rpx; }
.nameselect-group-head { margin-top: 0; }
.nameselect-choice-hint { display: block; margin-top: 5rpx; color: #8a94aa; font-size: 22rpx; }
.nameselect-refresh { display: flex !important; align-items: center; justify-content: center; min-width: 132rpx; height: 64rpx !important; margin: 0 !important; padding: 0 22rpx !important; box-sizing: border-box; border: 1rpx solid #b9ccef; border-radius: 999rpx !important; background: rgba(255, 255, 255, .78); color: #5273b7; font-size: 23rpx; line-height: 1; }
